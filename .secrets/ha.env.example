# Copy to .secrets/ha.env (gitignored) or set these as Cursor Cloud Agent secrets.
#
# Required for remote E2E deploy from iOS / cloud agent sessions:
HA_URL=https://YOUR_INSTANCE.ui.nabu.casa
HA_TOKEN=your_long_lived_access_token

# Optional — LAN or Tailscale IP for Samba package push (when agent can reach your network):
# HA_HOST=192.168.1.239

# Optional — SSH package push when SMB is unreachable from cloud (Tailscale SSH / HA SSH add-on):
# HA_SSH_HOST=100.x.x.x
# HA_SSH_USER=root
# HA_SSH_PORT=22
# HA_SSH_KEY_PATH=/path/to/private_key
